# =============================================================================
# Secret Santa Generator - Environment variables
# Copy this file to .env and edit the values.
# =============================================================================

# -----------------------------------------------------------------------------
# Server (backend)
# -----------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Admin credentials for the organizer dashboard.
# CHANGE THESE before deploying. Never commit real passwords to version control.
ADMIN_USERNAME=organizer
ADMIN_PASSWORD=ChangeMe123!

# Secret used to sign admin login tokens.
# CHANGE THIS to a long random string (e.g. output of `openssl rand -base64 32`).
JWT_SECRET=replace-with-a-long-random-secret-string

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
# In development this proxies to the local backend.
# In production set this to your backend URL (e.g. https://api.yourdomain.com).
VITE_API_URL=http://localhost:5000/api
